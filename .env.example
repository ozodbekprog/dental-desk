# Local dev: file:/absolute/path/to/prisma/dev.db
# Deployed (Turso): libsql://<db>-<org>.turso.io
DATABASE_URL="file:./prisma/dev.db"
TURSO_AUTH_TOKEN=""
AUTH_SECRET="change-me"
ADMIN_EMAIL="admin@dentaldesk.uz"
ADMIN_PASSWORD="change-me"

DEMO_ENABLED="true"

# Daily billing sweep (trial + subscription expiry)
CRON_SECRET="change-me"

# Optional OpenAI-compatible LLM for the in-app assistant.
# Leave AI_API_KEY empty to use the built-in offline assistant.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
